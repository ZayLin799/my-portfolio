# Copy to .env.local and fill in values from the Firebase console
# (Project settings > Your apps > Web app config).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: enables Firebase App Check on the contact form.
# Create a reCAPTCHA Enterprise key for your domain, then register it
# under Firebase console > App Check.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
